#!/usr/bin/env bash

set -euxo pipefail

if [[ "${OSTYPE}" = darwin* ]]; then
  brew install \
    enchant \
    font-jetbrains-mono \
    git \
    gopls \
    pkg-config \
    ripgrep

  exit 0
fi

# shellcheck source=/dev/null
source /etc/os-release

if [[ "${ID}" = fedora ]]; then
  dnf install \
    enchant2 \
    enchant2-devel \
    coreutils \
    git \
    gopls \
    jetbrains-mono-fonts \
    libsqlite3x-devel \
    pkgconf-pkg-config \
    ripgrep \
    wl-clipboard
fi
